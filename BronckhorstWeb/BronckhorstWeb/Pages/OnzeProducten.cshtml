@page
@using BronckhorstWeb.Api
@model OnzeProductenModel
@{
    ViewData["Title"] = "Onze Producten";
}

@section Styles {
    <link rel="stylesheet" href="~/styles/product.css" asp-append-version="true" />
}

<section class="catalog">
    <div class="catalog-heading">
        <p class="catalog-eyebrow">Jansdijk Implant Solutions</p>
        <h1>Onze producten</h1>
    </div>

    <form method="get" class="catalog-layout">
        <aside class="catalog-filters" aria-label="Productfilters">
            <div class="filter-heading">
                <h2>Filters</h2>
                <a asp-page="/OnzeProducten">Wis filters</a>
            </div>

            <label asp-for="Name">Zoeken</label>
            <input asp-for="Name" type="search" placeholder="Productnaam, artikelcode of productcode" />

            <label asp-for="BrandId">Merk</label>
            <select asp-for="BrandId">
                <option value="">Alle merken</option>
                @foreach (var brand in Model.Brands)
                {
                    <option value="@brand.Id">@brand.Name</option>
                }
            </select>

            <label asp-for="ParentCategoryId">Hoofdcategorie</label>
            <select asp-for="ParentCategoryId" aria-controls="CategoryId">
                <option value="">Kies een hoofdcategorie</option>
                @foreach (var category in Model.GetParentCategories())
                {
                    <option value="@category.Id">@(category.TranslatedName ?? category.Name)</option>
                }
            </select>

            <label asp-for="CategoryId">Subcategorie</label>
            <select asp-for="CategoryId" disabled="@(!Model.ParentCategoryId.HasValue)">
                <option value="">@(Model.ParentCategoryId.HasValue ? "Alle subcategorieën" : "Kies eerst een hoofdcategorie")</option>
                @foreach (var category in Model.GetSubCategories())
                {
                    <option value="@category.Id">@(category.TranslatedName ?? category.Name)</option>
                }
            </select>

            <input type="hidden" name="CurrentPage" value="1" />
            <button type="submit" class="filter-submit">Toepassen</button>
        </aside>

        <div class="catalog-results">
            <div class="catalog-controls">
                <p>@Model.Products.TotalCount @(Model.Products.TotalCount == 1 ? "productcode" : "productcodes")</p>
                <div class="catalog-selects">
                    <label>
                        Sortering
                        <select asp-for="Sort" onchange="this.form.submit()">
                            <option value="@ProductSort.NameAsc">Productcode, A-Z</option>
                            <option value="@ProductSort.NameDesc">Productcode, Z-A</option>
                            <option value="@ProductSort.PriceAsc">Prijs, laag naar hoog</option>
                            <option value="@ProductSort.PriceDesc">Prijs, hoog naar laag</option>
                        </select>
                    </label>
                    <label>
                        Per pagina
                        <select asp-for="PageSize" onchange="this.form.submit()">
                            <option value="12">12</option>
                            <option value="24">24</option>
                            <option value="48">48</option>
                        </select>
                    </label>
                </div>
            </div>

            @if (Model.LoadError is not null)
            {
                <p class="catalog-message" role="alert">@Model.LoadError</p>
            }
            else if (Model.Products.TotalCount == 0)
            {
                <p class="catalog-message">Geen producten gevonden met deze filters.</p>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var product in Model.Products.Items)
                    {
                        <a class="product-card" asp-page="/Product" asp-route-ProductCode="@product.ProductCode" asp-route-ReturnUrl="@(Request.Path + Request.QueryString)">
                            <div class="product-image">
                                @if (string.IsNullOrWhiteSpace(product.Image))
                                {
                                    <img src="~/images/implant.png" alt="" />
                                }
                                else
                                {
                                    <img src="~/images/ProductImages/@(product.Image).png" alt="@product.ProductCode" loading="lazy" />
                                }
                            </div>
                            <div class="product-content">
                                <h2>@(string.IsNullOrEmpty(product.ProductCode) ? "Zonder productcode" : product.ProductCode)</h2>
                                <p class="product-description">@product.ProductCount @(product.ProductCount == 1 ? "product" : "producten")</p>
                                <p class="product-price">Vanaf @product.FromPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("nl-NL"))</p>
                            </div>
                        </a>
                    }
                </div>

                <nav class="pagination" aria-label="Paginanavigatie">
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-page="/OnzeProducten" asp-route-CurrentPage="@(Model.Products.Page - 1)" asp-route-BrandId="@Model.BrandId" asp-route-ParentCategoryId="@Model.ParentCategoryId" asp-route-CategoryId="@Model.CategoryId" asp-route-Name="@Model.Name" asp-route-PageSize="@Model.PageSize" asp-route-Sort="@Model.Sort">Vorige</a>
                    }
                    else
                    {
                        <span aria-disabled="true">Vorige</span>
                    }
                    <span>Pagina @Model.Products.Page van @Model.TotalPages</span>
                    @if (Model.HasNextPage)
                    {
                        <a asp-page="/OnzeProducten" asp-route-CurrentPage="@(Model.Products.Page + 1)" asp-route-BrandId="@Model.BrandId" asp-route-ParentCategoryId="@Model.ParentCategoryId" asp-route-CategoryId="@Model.CategoryId" asp-route-Name="@Model.Name" asp-route-PageSize="@Model.PageSize" asp-route-Sort="@Model.Sort">Volgende</a>
                    }
                    else
                    {
                        <span aria-disabled="true">Volgende</span>
                    }
                </nav>
            }
        </div>
    </form>
</section>

@section Scripts {
    <script id="catalog-categories" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Categories))</script>
    <script src="~/js/catalog.js" asp-append-version="true"></script>
}
